# TruthLens AI Environment Configuration

# Bifrost AI Gateway (OpenAI-compatible)
BIFROST_BASE_URL=https://api.bifrost.maxim.ai/v1
BIFROST_API_KEY=
BIFROST_MODEL=gpt-4o-mini
BIFROST_FALLBACK_MODEL=claude-3-5-haiku

# Tavily Live Search API
TAVILY_API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./truthlens.db

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
ENVIRONMENT=development
